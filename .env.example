# Go server configuration
RETENTION_DAYS=30
MIGRATIONS_PATH=/usr/local/share/relay-go/migrations
JWT_SECRET=changeme-use-openssl-rand-hex-32
DATABASE_URL=postgres://username:password@localhost:5432/relay?sslmode=disable
AUTH_SERVICE_ADDR=localhost:50051
NATS_URL=nats://localhost:4222
MESSAGING_SERVICE_ADDR=localhost:50052
PRESENCE_SERVICE_ADDR=localhost:50053

# Docker Compose configuration (PostgreSQL container)
POSTGRES_USER=your-db-user
POSTGRES_PASSWORD=your-db-password
POSTGRES_DB=relay
POSTGRES_HOST=localhost
POSTGRES_PORT=5432